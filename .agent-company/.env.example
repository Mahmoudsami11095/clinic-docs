# ClinicCorp AI — LLM Provider Configuration
# Copy this file to .agent-company/.env and populate your preferred key.

# Provider Selection: "gemini" | "openai" | "azure" | "auto"
LLM_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Azure OpenAI (Optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
